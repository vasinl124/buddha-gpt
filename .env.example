# Copy to .env and fill in; .env is git-ignored. See docs/PRD.md §7.2.
# The Go core, the agent and Docker Compose read this file. Next.js reads only its own env,
# and its default for NEXT_PUBLIC_API_URL already points at the agent.

OPENROUTER_API_KEY=
# The reply model on OpenRouter (default deepseek/deepseek-v4-flash-0731). With no key, a mock model answers.
AGENT_MODEL=
# Host port for the Docker Postgres. If 5432 is taken, change it here and in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/buddha_gpt
RETRIEVAL_URL=http://localhost:7890
# Where the Go core listens: loopback by default, since only the agent should reach it. Set :7890
# to open it to a private network when the agent runs on another host.
CORE_ADDR=
# Behind a reverse proxy, which hops the agent believes for the client's address and protocol
# (Express's "trust proxy"): a hop count such as 1, or addresses such as loopback.
TRUST_PROXY=
NEXT_PUBLIC_API_URL=http://localhost:7891
# Hosted, the web app's build reaches the agent under its own origin: AGENT_URL is the agent's
# private address, with NEXT_PUBLIC_API_URL=/agent (PRD §7.4). Unset locally.
AGENT_URL=
CORS_ORIGINS=http://localhost:5005
# Set to 1 only for `pnpm eval`: turns on eval mode (JSON replies with a debug block).
EVAL_MODE=
# The eval's judge, from another model family than the agent's (PRD §10).
JUDGE_MODEL=openai/gpt-5-mini
# Embeddings default to baai/bge-m3 on OpenRouter. Any OpenAI-compatible endpoint works, e.g. a
# local Ollama during development: EMBED_BASE_URL=http://localhost:11434/v1 EMBED_MODEL=nomic-embed-text
EMBED_MODEL=
EMBED_BASE_URL=
